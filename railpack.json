{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": [
    "...", "unzip", "ca-certificates", "fonts-liberation", "libasound2t64",
    "libatk-bridge2.0-0t64", "libatk1.0-0t64", "libatspi2.0-0t64", "libc6",
    "libcairo2", "libcups2t64", "libcurl4t64", "libdbus-1-3", "libexpat1",
    "libgbm1", "libglib2.0-0t64", "libgtk-3-0t64", "libnspr4", "libnss3",
    "libpango-1.0-0", "libudev1", "libvulkan1", "libx11-6", "libxcb1",
    "libxcomposite1", "libxdamage1", "libxext6", "libxfixes3", "libxkbcommon0",
    "libxrandr2", "wget", "xdg-utils"
  ],
  "steps": {
    "build": {
      "commands": ["node scripts/build-native-checker.mjs", "node scripts/prepare-software-browser.mjs"]
    }
  },
  "deploy": {
    "paths": ["/app/.cache/software-browser/bin", "..."],
    "aptPackages": [
      "...", "ca-certificates", "fonts-liberation", "libasound2t64",
      "libatk-bridge2.0-0t64", "libatk1.0-0t64", "libatspi2.0-0t64", "libc6",
      "libcairo2", "libcups2t64", "libcurl4t64", "libdbus-1-3", "libexpat1",
      "libgbm1", "libglib2.0-0t64", "libgtk-3-0t64", "libnspr4", "libnss3",
      "libpango-1.0-0", "libudev1", "libvulkan1", "libx11-6", "libxcb1",
      "libxcomposite1", "libxdamage1", "libxext6", "libxfixes3", "libxkbcommon0",
      "libxrandr2", "wget", "xdg-utils"
    ]
  }
}
