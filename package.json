{
  "name": "sara",
  "version": "1.0.0",
  "private": true,
  "description": "SARA — an owner-controlled self-development kernel built on TGRM.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoneManTGRM/SARA.git"
  },
  "bugs": {
    "url": "https://github.com/BoneManTGRM/SARA/issues"
  },
  "homepage": "https://github.com/BoneManTGRM/SARA#readme",
  "keywords": [
    "sara",
    "tgrm",
    "reparodynamics",
    "rye",
    "self-repair",
    "llm",
    "self-development",
    "owner-controlled"
  ],
  "exports": {
    ".": "./tgrm/index.ts"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "node --import tsx cli.ts",
    "start": "node --import tsx scripts/start-runtime.ts",
    "proof:bootstrap": "node --import tsx proof/bootstrap.ts",
    "proof:self-build": "node --import tsx proof/self-build.ts",
    "proof:revenue-pilot": "node --import tsx proof/revenue-pilot.ts",
    "proof:reparodynamic-coding": "node --import tsx proof/reparodynamic-coding.ts",
    "benchmark:coding:offline": "node --import tsx proof/reparodynamic-coding.ts",
    "benchmark:coding:live": "node --import tsx scripts/benchmark-reparodynamic-coding.ts --live",
    "proof:http": "node --import tsx --test tests/http.test.ts",
    "executor:site": "node --import tsx scripts/site-directive-executor.ts",
    "executor:cloudflare": "node --import tsx scripts/cloudflare-objective-executor.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck && npm run demo && npm run proof:bootstrap && npm run proof:self-build && npm run proof:revenue-pilot && npm run proof:reparodynamic-coding && npm run proof:http"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0"
  }
}
